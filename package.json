{
  "name": "dsh-wait-chime",
  "version": "0.2.0",
  "description": "DSH 等待提醒插件：助手向你提问（ask_user_question）或需要额外权限（审批）时播放提示音，并在 DSH 设置面板里提供开关与连续响度调节。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "assets",
    "test",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "PROVENANCE.md",
    "ARCHIVED.md"
  ],
  "scripts": {
    "test": "node test/smoke.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yingqianlan1234/dsh-wait-chime.git"
  },
  "homepage": "https://github.com/yingqianlan1234/dsh-wait-chime#readme",
  "bugs": {
    "url": "https://github.com/yingqianlan1234/dsh-wait-chime/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "notification",
    "chime",
    "waiting"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
